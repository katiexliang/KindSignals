# KindSignals backend configuration.
# Copy to `.env` and fill in as needed. NEVER commit real secrets.

# Database (local SQLite by default)
DATABASE_URL=sqlite:///./kindsignals.db

# PMOS Buddy LLM provider.
# "fallback" (default) uses the deterministic, no-key provider.
# "openai" enables the optional OpenAI provider (requires LLM_API_KEY).
LLM_PROVIDER=fallback

# Only needed when LLM_PROVIDER is not "fallback".
LLM_API_KEY=

# OpenAI chat model used when LLM_PROVIDER=openai.
LLM_MODEL=gpt-4o-mini

# Secret for signing session tokens. Set a long random value in production.
AUTH_SECRET=kindsignals-dev-secret-change-me

# Comma-separated list of allowed CORS origins (frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
